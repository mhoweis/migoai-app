{
  "name": "migo-monorepo",
  "version": "1.0.0",
  "description": "MIGO - AI-Powered Event Discovery Platform (Monorepo)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:mobile",
    "dev:backend": "npm run dev --workspace=@migo/backend",
    "dev:mobile": "npm run start --workspace=@migo/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=@migo/backend",
    "build:mobile:android": "npm run build:android --workspace=@migo/mobile",
    "build:mobile:ios": "npm run build:ios --workspace=@migo/mobile",
    "build:shared": "npm run build --workspace=@migo/shared",
    "prisma:generate": "npm run prisma:generate --workspace=@migo/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@migo/backend",
    "prisma:studio": "npm run prisma:studio --workspace=@migo/backend",
    "prisma:seed": "npm run prisma:seed --workspace=@migo/backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install",
    "test": "npm run test --workspaces --if-present",
    "prepare": "npm run build:shared",
    "predev": "npm run build:shared",
    "predev:backend": "npm run build:shared"
  },
  "keywords": [
    "events",
    "ai",
    "discovery",
    "ticketing",
    "social",
    "monorepo"
  ],
  "author": "MIGO TEAM",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "5.11.1"
    },
    "@google-cloud/storage": {
      "fast-xml-parser": "4.5.7"
    },
    "basic-ftp": "6.2.1",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "websocket-driver": "0.7.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  }
}
