# Puppeteer's Chrome download is skipped via apps/backend/.puppeteerrc.cjs
# (the .npmrc key is not honoured reliably by Puppeteer v24 in a workspace
# postinstall, so the config file is authoritative).

# Expo/React Native pull in a wide dependency graph with a lot of legacy peer
# ranges. Without this, npm install fails on peer conflicts that do not matter
# in practice.
legacy-peer-deps=true
