{
  "name": "@migo/backend",
  "version": "1.0.0",
  "description": "MIGO - AI-Powered Event Discovery Platform (Backend API)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:reset": "rm -f .env && npm run setup:env && npm run dev",
    "setup:env": "node scripts/setup-env.js",
    "build": "tsc",
    "build:deploy": "prisma generate && tsc || test -f dist/server.js",
    "start": "node dist/server.js",
    "start:deploy": "prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:friends": "ts-node prisma/seed-friends.ts",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma migrate reset",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "collect:events": "ts-node src/scripts/collect-events.ts",
    "tourism:crawl": "ts-node src/scripts/crawl-tourism.ts",
    "import:platinumlist": "node scripts/import-platinumlist.js",
    "docker:build": "docker build -t migo-backend .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": [
    "events",
    "ai",
    "discovery",
    "ticketing",
    "social"
  ],
  "author": "MIGO TEAM",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@migo/shared": "*",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/client": "6.19.1",
    "@sendgrid/mail": "^8.1.6",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@types/dotenv": "^6.1.1",
    "ai-sdk-ollama": "^3.3.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.5",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "nodemailer": "^7.0.12",
    "passkit-generator": "3.6.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^24.32.1",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "twilio": "^5.10.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prisma": "6.19.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
