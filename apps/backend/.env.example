# ============================================
# Migo Backend — copy to .env and fill in
#   cp .env.example .env
#
# Note: scripts/setup-env.js is stale (it still writes a MySQL DATABASE_URL
# and omits SUPABASE_DATABASE_URL). Use this file instead.
# ============================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
APP_PUBLIC_URL=

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the POOLER url (port 6543) and append the pgbouncer params, otherwise
# you get prepared-statement errors under load.
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432). Prisma MIGRATIONS fail against the pooler,
# so they need this one.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
TICKET_SIGNING_SECRET=
COOKIE_SECRET=replace_me

# ── Dev auth escape hatch ────────────────────────────────────────────────────
# When true AND NODE_ENV=development, AI routes fall back to a test user
# instead of requiring a JWT. NEVER set this anywhere but your own machine.
ALLOW_DEV_AUTH=false

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cost governance — see services/llm-budget.service.ts
AI_GLOBAL_DAILY_CAP_USD=30
AI_GLOBAL_WARN_RATIO=0.8
AI_FREE_DAILY_MESSAGES=20
AI_FREE_DAILY_TOKENS=60000
AI_PLUS_DAILY_MESSAGES=300
AI_PLUS_DAILY_TOKENS=1000000
AI_INPUT_COST_PER_MTOK=0.3
AI_OUTPUT_COST_PER_MTOK=2.5
AI_BURST_MAX=5
AI_BURST_WINDOW_MS=60000
AI_MAX_INPUT_CHARS=1000

# ── Places / Google Maps scraper ─────────────────────────────────────────────
SCRAPER_BASE_URL=http://localhost:8080
SCRAPER_API_KEY=
# Comma-separated, e.g. socks5://user:pass@host:port — add for heavy use
SCRAPER_PROXIES=

# Set to false on any instance that must NOT scrape (e.g. Replit, which has
# no Docker). The API still serves cached places.
PLACES_WORKER_ENABLED=true
PLACES_CACHE_TTL_HOURS=336
PLACES_SEARCH_MAX_PER_HOUR=20
PLACES_JOB_COOLDOWN_MS=20000
PLACES_MAX_ATTEMPTS=3
GEOCODE_COUNTRY_CODES=ae

# ── Affiliates ───────────────────────────────────────────────────────────────
PLATINUMLIST_AFF_REF=nmu2yjg
# Set once Platinumlist confirms which sub-ID param they support
PLATINUMLIST_SUBID_PARAM=
IP_HASH_SALT=replace_me_with_random_string

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# ── Optional ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDERS_CRON=0 5 * * *
WEEKEND_DIGEST_CRON=0 6 * * 4
GOOGLE_MAPS_API_KEY=
TICKETMASTER_MAX_PAGES=3
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_IDS=
DISCOVERY_PROVIDERS_DISABLED=
# Chrome/Chromium used by browser-based providers (MyDubai Communities) when the site blocks plain HTTP.
# Leave empty to use Puppeteer's bundled Chrome.
PUPPETEER_EXECUTABLE_PATH=
EXPO_CITY_CONTENTFUL_TOKEN=
VISIT_DUBAI_ALGOLIA_APP_ID=
VISIT_DUBAI_ALGOLIA_API_KEY=
VISIT_DUBAI_ALGOLIA_INDEX=prod104_vd_en
# Optional overrides for DIFC's public Algolia search-only credentials.
DIFC_ALGOLIA_APP_ID=
DIFC_ALGOLIA_API_KEY=
UAE_GOV_MONTHS_AHEAD=6
YAS_ISLAND_COVEO_TOKEN=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_PEM=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
MOCK_EVENTS_PROVIDER=false
SYNC_CITIES=Dubai,Abu Dhabi,Sharjah,Ras Al Khaimah
EVENT_SYNC_INTERVAL_MINUTES=60
EVENT_SYNC_ON_BOOT=true
HOST_PLAN_PRICE_AED=99
SUPPLIER_PLAN_PRICE_AED=499
# Development-only; allows HTTP and localhost for local supplier feed fixtures.
SUPPLIER_FEED_ALLOW_PRIVATE_HOSTS=false
