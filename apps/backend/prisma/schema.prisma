generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase port 6543, transaction mode) for queries.
  url      = env("SUPABASE_DATABASE_URL")
  // Direct connection (port 5432) for migrations. Prisma migrations FAIL
  // against the transaction pooler, so this must be set wherever migrations
  // run — and, because Prisma resolves it at generate time, everywhere else too.
  directUrl = env("DIRECT_URL")
}

// Enums
enum UserRole {
  USER
  ADMIN
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
  ARCHIVED
  DELETED
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EventLocationType {
  VENUE
  ONLINE
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  CHECKED_IN
}

enum BookingType {
  FREE
  PAID
  DONATION
  RSVP
}

enum TransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

// Models
model User {
  id                        String              @id @default(cuid())
  email                     String?             @unique @db.VarChar(255)
  phone                     String?             @unique @db.VarChar(20)
  password                  String?             @db.VarChar(255)
  name                      String?             @db.VarChar(255)
  displayName               String?             @map("display_name") @db.VarChar(255)
  avatar                    String?             @db.Text
  avatarUrl                 String?             @map("avatar_url") @db.Text
  bio                       String?             @db.Text
  role                      UserRole            @default(USER)
  emailVerified             Boolean             @default(false) @map("email_verified")
  phoneVerified             Boolean             @default(false) @map("phone_verified")
  isVerified                Boolean             @default(false) @map("is_verified")
  isOrganizer               Boolean             @default(false) @map("is_organizer")
  isAdmin                   Boolean             @default(false) @map("is_admin")
  
  // Preferences
  interests                 Json?
  preferences               Json?
  settings                  Json?
  
  // Stats
  eventCount                Int?                @default(0) @map("event_count")
  wishlistCount             Int?                @default(0) @map("wishlist_count")
  followerCount             Int?                @default(0) @map("follower_count")
  followingCount            Int?                @default(0) @map("following_count")
  
  
  // Phone verification
  phoneVerificationCode     String?             @map("phone_verification_code") @db.VarChar(10)
  phoneVerificationExpires  DateTime?           @map("phone_verification_expires")
  
  // Social auth
  firebaseUid               String?             @unique @map("firebase_uid") @db.VarChar(255)
  authMethod                String?             @map("auth_method") @db.VarChar(50)
  googleId                  String?             @unique @map("google_id") @db.VarChar(255)
  appleId                   String?             @unique @map("apple_id") @db.VarChar(255)
  facebookId                String?             @unique @map("facebook_id") @db.VarChar(255)
  
  // Social links
  website                   String?             @db.Text
  twitter                   String?             @db.VarChar(255)
  instagram                 String?             @db.VarChar(255)
  linkedin                  String?             @db.VarChar(255)
  
  // Relations
  passkeys                  Passkey[]
  passkeyChallenges         PasskeyChallenge[]
  refreshTokens             RefreshToken[]
  organizedEvents           Event[]             @relation("Organizer")
  bookings                  Booking[]
  reviews                   Review[]
  wishlists                 Wishlist[]
  eventViews                EventView[]
  searchLogs                SearchLog[]
  organizerProfile          OrganizerProfile?
  notifications             Notification[]
  deviceTokens              DeviceToken[]
  conversationLogs          ConversationLog[]
  chatSessions              ChatSession[]
  following                 Follow[]            @relation("Following")
  followers                 Follow[]            @relation("Followers")
  createdInvites            EventInvite[]       @relation("Inviter")
  transfersSent             TicketTransfer[]   @relation("TransfersSent")
  transfersReceived         TicketTransfer[]   @relation("TransfersReceived")
  
  // Timestamps
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  lastLoginAt               DateTime?           @map("last_login_at")
  lastActiveAt              DateTime?           @map("last_active_at")

  @@map("users")
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@index([isOrganizer])
  @@index([isVerified])
}

model Event {
  id                        String              @id @default(cuid())
  migoId                    String?             @unique @map("migo_id") @db.VarChar(255)
  slug                      String?             @unique @db.VarChar(255)
  title                     String              @db.VarChar(255)
  tagline                   String?             @db.VarChar(500)
  description               String              @db.Text
  shortDescription          String?             @map("short_description") @db.VarChar(500)
  category                  String              @db.VarChar(100)
  subcategory               String?             @db.VarChar(100)
  tags                      Json? // Changed from String[]
  
  // Dates
  startDate                 DateTime            @map("start_date")
  endDate                   DateTime?           @map("end_date")
  durationMinutes           Int?                @map("duration_minutes")
  timezone                  String              @default("UTC") @db.VarChar(50)
  isRecurring               Boolean             @default(false) @map("is_recurring")
  
  // Location
  venueName                 String?             @map("venue_name") @db.VarChar(255)
  address                   String?             @db.Text
  city                      String?             @db.VarChar(100)
  country                   String?             @db.VarChar(100)
  latitude                  Float?
  longitude                 Float?
  locationType              EventLocationType   @default(VENUE) @map("location_type")
  onlineUrl                 String?             @map("online_url") @db.Text
  
  // Pricing
  priceFrom                 Decimal?            @map("price_from") @db.Decimal(10, 2)
  priceTo                   Decimal?            @map("price_to") @db.Decimal(10, 2)
  currency                  String              @default("USD") @db.VarChar(3)
  isFree                    Boolean             @default(false) @map("is_free")
  ticketUrl                 String?             @map("ticket_url") @db.Text
  bookingType               BookingType         @default(PAID) @map("booking_type")
  capacity                  Int?                @default(0)
  ticketsSold               Int?                @default(0) @map("tickets_sold")
  ticketsAvailable          Int?                @default(0) @map("tickets_available")
  
  // Media
  images                    Json? // Changed from String[]
  coverImage                String?             @map("cover_image") @db.Text
  thumbnailImage            String?             @map("thumbnail_image") @db.Text
  videoUrl                  String?             @map("video_url") @db.Text
  gallery                   Json?
  
  // Features
  isPetFriendly             Boolean             @default(false) @map("is_pet_friendly")
  isWheelchairAccessible    Boolean             @default(false) @map("is_wheelchair_accessible")
  hasParking                Boolean             @default(false) @map("has_parking")
  hasFood                   Boolean             @default(false) @map("has_food")
  hasDrinks                 Boolean             @default(false) @map("has_drinks")
  hasWiFi                   Boolean             @default(false) @map("has_wifi")
  facilities                Json? // Changed from String[]
  dressCode                 String?             @map("dress_code") @db.VarChar(100)
  ageRestriction            Int?                @map("age_restriction")
  ageGroup                  String?             @map("age_group") @db.VarChar(50)
  
  // Status
  status                    EventStatus         @default(PENDING)
  visibility                EventVisibility     @default(PUBLIC)
  isFeatured                Boolean             @default(false) @map("is_featured")
  isSponsored               Boolean             @default(false) @map("is_sponsored")
  isVerified                Boolean             @default(false) @map("is_verified")
  featuredOrder             Int?                @map("featured_order")
  featuredUntil             DateTime?           @map("featured_until")
  
  // External
  externalId                String?             @unique @map("external_id") @db.VarChar(255)
  externalSource            String?             @map("external_source") @db.VarChar(50)
  externalUrl               String?             @map("external_url") @db.Text
  source                    String?             @db.VarChar(50)
  
  // Contact
  organizerEmail            String?             @map("organizer_email") @db.VarChar(255)
  organizerPhone            String?             @map("organizer_phone") @db.VarChar(20)
  supportEmail              String?             @map("support_email") @db.VarChar(255)
  supportPhone              String?             @map("support_phone") @db.VarChar(20)
  website                   String?             @db.Text
  socialLinks               Json?               @map("social_links")
  
  // Stats
  views                     Int?                @default(0)
  uniqueViews               Int?                @default(0) @map("unique_views")
  wishlistCount             Int?                @default(0) @map("wishlist_count")
  shareCount                Int?                @default(0) @map("share_count")
  clickCount                Int?                @default(0) @map("click_count")
  ratingAverage             Float?              @default(0) @map("rating_average")
  ratingCount               Int?                @default(0) @map("rating_count")
  
  // Relations
  organizerId               String              @map("organizer_id")
  organizer                 User                @relation("Organizer", fields: [organizerId], references: [id])
  bookings                  Booking[]
  reviews                   Review[]
  wishlists                 Wishlist[]
  eventViews                EventView[]
  searchLogs                SearchLog[]
  categoryRelation          Category?           @relation(fields: [categoryId], references: [id])
  categoryId                String?             @map("category_id")
  eventInvites              EventInvite[]
  
  // Timestamps
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  publishedAt               DateTime?           @map("published_at")
  approvedAt                DateTime?           @map("approved_at")
  lastSyncedAt              DateTime?           @map("last_synced_at")

  @@map("events")
  @@index([organizerId])
  @@index([category])
  @@index([subcategory])
  @@index([city])
  @@index([country])
  @@index([startDate])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([isFree])
  @@index([isPetFriendly])
  @@index([ratingAverage])
  @@index([wishlistCount])
  @@index([createdAt])
  @@index([slug])
  @@index([categoryId])
}

model Booking {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  eventId         String        @map("event_id")
  ticketCount     Int           @default(1) @map("ticket_count")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(10, 2)
  currency        String        @default("USD") @db.VarChar(3)
  status          BookingStatus @default(PENDING)
  bookingDate     DateTime      @default(now()) @map("booking_date")
  ticketUrl       String?       @map("ticket_url") @db.Text
  qrCode          String?       @map("qr_code") @db.Text
  transactionId   String?       @map("transaction_id") @db.VarChar(255)
  paymentMethod   String?       @map("payment_method") @db.VarChar(50)
  notes           String?       @db.Text
  inviteCode      String?       @map("invite_code") @db.VarChar(16)
  
  // Contact info for ticket
  attendeeName    String?       @map("attendee_name") @db.VarChar(255)
  attendeeEmail   String?       @map("attendee_email") @db.VarChar(255)
  attendeePhone   String?       @map("attendee_phone") @db.VarChar(20)
  
  // Check-in
  checkedInAt     DateTime?     @map("checked_in_at")
  checkedInBy     String?       @map("checked_in_by") @db.VarChar(255)
  
  // Relations
  user            User          @relation(fields: [userId], references: [id])
  event           Event         @relation(fields: [eventId], references: [id])
  transfers       TicketTransfer[]

  @@map("bookings")
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([bookingDate])
  @@unique([userId, eventId])
}

model TicketTransfer {
  id          String         @id @default(cuid())
  bookingId   String         @map("booking_id")
  fromUserId  String         @map("from_user_id")
  toUserId    String?        @map("to_user_id")
  toEmail     String         @map("to_email") @db.VarChar(255)
  code        String         @unique @db.VarChar(24)
  status      TransferStatus @default(PENDING)
  expiresAt   DateTime       @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  acceptedAt  DateTime?      @map("accepted_at")
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUser    User           @relation("TransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User?          @relation("TransfersReceived", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([toEmail])
  @@map("ticket_transfers")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model EventInvite {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(16)
  eventId   String   @map("event_id")
  inviterId String   @map("inviter_id")
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter   User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviterId])
  @@map("event_invites")
}

model Review {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  eventId         String    @map("event_id")
  overallRating   Int       @default(5) @map("overall_rating")
  title           String?   @db.VarChar(200)
  comment         String?   @db.Text
  isRecommended   Boolean   @default(true) @map("is_recommended")
  isFeatured      Boolean   @default(false) @map("is_featured")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  event           Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
  @@index([userId])
  @@index([eventId])
  @@index([overallRating])
  @@index([isFeatured])
  @@index([createdAt])
}

model Wishlist {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  eventId         String    @map("event_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  event           Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("wishlists")
  @@index([userId])
  @@index([eventId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  credentialID  String   @unique
  publicKey     Bytes
  counter       BigInt
  deviceType    String?   @db.VarChar(50)
  backedUp      Boolean  @default(false)
  transports    Json?
  
  // Relations
  user          User     @relation(fields: [userId], references: [id])
  
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  type      String   @db.VarChar(20)
  expiresAt DateTime
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("passkey_challenges")
}

// New models needed for the events service

model EventView {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  userId          String?  @map("user_id")
  sessionId       String?  @map("session_id") @db.VarChar(255)
  source          String   @db.VarChar(50)
  deviceType      String?  @map("device_type") @db.VarChar(50)
  userAgent       String?  @map("user_agent") @db.Text
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  viewedAt        DateTime @default(now()) @map("viewed_at")
  
  // Relations
  event           Event    @relation(fields: [eventId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@map("event_views")
  @@index([eventId])
  @@index([userId])
  @@index([viewedAt])
  @@index([source])
}

model SearchLog {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  eventId         String?  @map("event_id")
  query           String   @db.VarChar(255)
  filters         Json?
  resultsCount    Int      @map("results_count")
  deviceType      String?  @map("device_type") @db.VarChar(50)
  userAgent       String?  @map("user_agent") @db.Text
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  user            User?    @relation(fields: [userId], references: [id])
  event           Event?   @relation(fields: [eventId], references: [id])

  @@map("search_logs")
  @@index([userId])
  @@index([query])
  @@index([createdAt])
  @@index([eventId])
}

model OrganizerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  businessName    String    @map("business_name") @db.VarChar(255)
  businessEmail   String?   @map("business_email") @db.VarChar(255)
  businessPhone   String?   @map("business_phone") @db.VarChar(20)
  businessWebsite String?   @map("business_website") @db.Text
  description     String?   @db.Text
  logo            String?   @db.Text
  banner          String?   @db.Text
  taxId           String?   @map("tax_id") @db.VarChar(50)
  vatNumber       String?   @map("vat_number") @db.VarChar(50)
  
  // Social
  socialLinks     Json?     @map("social_links")
  
  // Stats
  totalEvents     Int       @default(0) @map("total_events")
  totalSales      Decimal?  @default(0) @map("total_sales") @db.Decimal(12, 2)
  averageRating   Float?    @default(0) @map("average_rating")
  reviewCount     Int       @default(0) @map("review_count")
  
  // Verification
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  
  // Bank/Stripe info
  stripeAccountId String?   @map("stripe_account_id") @db.VarChar(255)
  bankAccount     Json?     @map("bank_account")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])

  @@map("organizer_profiles")
  @@index([userId])
  @@index([businessName])
  @@index([isVerified])
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique @db.VarChar(100)
  slug            String    @unique @db.VarChar(100)
  description     String?   @db.Text
  icon            String?   @db.VarChar(50)
  color           String?   @db.VarChar(7)
  parentId        String?   @map("parent_id")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  parent          Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories   Category[] @relation("CategoryHierarchy")
  events          Event[]
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("categories")
  @@index([slug])
  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
}

model Tag {
  id              String    @id @default(cuid())
  name            String    @unique @db.VarChar(100)
  slug            String    @unique @db.VarChar(100)
  description     String?   @db.Text
  usageCount      Int       @default(0) @map("usage_count")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("tags")
  @@index([slug])
  @@index([usageCount])
  @@index([isActive])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(255)
  message         String    @db.Text
  data            Json?
  isRead          Boolean   @default(false) @map("is_read")
  isSent          Boolean   @default(false) @map("is_sent")
  sendAt          DateTime? @map("send_at")
  sentAt          DateTime? @map("sent_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("notifications")
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([isSent])
  @@index([sendAt])
}

model DeviceToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  token           String    @unique @db.VarChar(500) // Changed from @db.Text
  platform        String    @db.VarChar(20)
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("device_tokens")
  @@index([userId])
  @@index([platform])
  @@index([isActive])
}

model ConversationLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  userMessage  String   @map("user_message")
  aiResponse   String   @map("ai_response")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([createdAt])
  @@map("conversation_logs")
}

model ChatSession {
  id              String        @id @default(cuid())
  sessionId       String        @unique @map("session_id") @db.VarChar(255)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  title           String?       @db.VarChar(255)
  context         Json?
  messageCount    Int           @default(0) @map("message_count")
  tokenCount      Int           @default(0) @map("token_count")
  durationMinutes Int           @default(0) @map("duration_minutes")
  isActive        Boolean       @default(true) @map("is_active")
  isArchived      Boolean       @default(false) @map("is_archived")
  archivedAt      DateTime?     @map("archived_at")
  lastMessageAt   DateTime?     @map("last_message_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  messages        ChatMessage[]
  
  @@map("chat_sessions")
  @@index([userId])
  @@index([sessionId])
  @@index([isActive])
  @@index([isArchived])
  @@index([lastMessageAt])
}

model ChatMessage {
  id              String        @id @default(cuid())
  sessionId       String        @map("session_id")
  session         ChatSession   @relation(fields: [sessionId], references: [id])
  role            String        @db.VarChar(20)
  content         String        @db.Text
  tokens          Int?          @default(0)
  aiModel         String?       @map("ai_model") @db.VarChar(100)
  aiResponseTime  Int?          @map("ai_response_time")
  aiUsage         Json?         @map("ai_usage")
  context         Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  
  @@map("chat_messages")
  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}
// ─────────────────────────────────────────────────────────────────────────────
// Phase 0: AI cost governance + signal capture
// ─────────────────────────────────────────────────────────────────────────────

/// Per-user, per-day AI usage. Enforces the free-tier quota and the
/// per-user token budget without trusting the model or the client.
model AiUsageDaily {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  day           DateTime @db.Date
  messages      Int      @default(0)
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  costUsd       Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, day])
  @@index([day])
  @@map("ai_usage_daily")
}

/// Global daily LLM spend, plus the kill switch. One row per UTC day.
/// When `killed` is true the agent degrades to plain search for everyone.
model AiSpendDaily {
  day       DateTime @id @db.Date
  costUsd   Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  calls     Int      @default(0)
  killed    Boolean  @default(false)
  killedAt  DateTime? @map("killed_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_spend_daily")
}

/// Append-only behavioural signals. Written by the click-out redirect in
/// Phase 0; the taste model reads this table from week 6 onward.
model UserSignal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventId   String?  @map("event_id")
  type      String   @db.VarChar(40)
  weight    Float    @default(0)
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([type])
  @@map("user_signals")
}

/// One row per click-out, so affiliate payouts can be attributed back to a
/// user, an event and a feed placement. `token` is the opaque sub-ID we pass
/// to the supplier when they support one.
model AffiliateClick {
  id          String   @id @default(cuid())
  token       String   @unique @db.VarChar(64)
  userId      String?  @map("user_id")
  eventId     String   @map("event_id")
  supplier    String   @db.VarChar(50)
  targetUrl   String   @map("target_url") @db.Text
  placement   String?  @db.VarChar(60)
  ipHash      String?  @map("ip_hash") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([supplier, createdAt])
  @@map("affiliate_clicks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Places: Google Maps venue discovery
//
// The scraper is slow (30s–10min per job) and rate-limited by Google, so the
// user-facing API never scrapes inline. It reads this cache, and only enqueues
// a job on a cache miss. Results are shared across all users.
// ─────────────────────────────────────────────────────────────────────────────

/// A business/venue as returned by Google Maps. Deduped on `externalId`.
model Place {
  id            String    @id @default(cuid())
  /// Google's stable identifier (cid / data_id). Falls back to a hash of
  /// title+address when the scraper returns neither.
  externalId    String    @unique @map("external_id") @db.VarChar(191)

  title         String    @db.VarChar(300)
  category      String?   @db.VarChar(150)
  address       String?   @db.Text
  city          String?   @db.VarChar(120)
  country       String?   @db.VarChar(120)

  latitude      Float?
  longitude     Float?

  phone         String?   @db.VarChar(60)
  website       String?   @db.Text
  mapsUrl       String?   @map("maps_url") @db.Text
  thumbnail     String?   @db.Text
  priceRange    String?   @map("price_range") @db.VarChar(20)

  rating        Float?
  reviewCount   Int?      @default(0) @map("review_count")

  /// Social handles found by scanning the venue's own website.
  instagram     String?   @db.VarChar(300)
  facebook      String?   @db.VarChar(300)
  linkedin      String?   @db.VarChar(300)

  /// True once a human has confirmed this is a real event venue worth keeping.
  isVenue       Boolean   @default(false) @map("is_venue")
  /// Suppressed places never appear in user results.
  isHidden      Boolean   @default(false) @map("is_hidden")

  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")

  hits          PlaceSearchHit[]

  @@index([city])
  @@index([category])
  @@index([latitude, longitude])
  @@index([isVenue])
  @@index([rating])
  @@map("places")
}

/// One scrape job. `queryKey` is the cache key: normalized keyword + rounded
/// coordinates + depth, so two users asking the same thing share one job.
model PlaceSearch {
  id           String    @id @default(cuid())
  queryKey     String    @unique @map("query_key") @db.VarChar(400)

  keyword      String    @db.VarChar(300)
  latitude     Float
  longitude    Float
  radiusMeters Int       @default(10000) @map("radius_meters")
  depth        Int       @default(5)

  /// pending → running → ok | failed
  status       String    @default("pending") @db.VarChar(20)
  jobId        String?   @map("job_id") @db.VarChar(100)
  resultCount  Int       @default(0) @map("result_count")
  error        String?   @db.Text

  requestedBy  String?   @map("requested_by")
  attempts     Int       @default(0)

  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  /// Results are served from cache until this passes.
  expiresAt    DateTime? @map("expires_at")

  hits         PlaceSearchHit[]

  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
  @@map("place_searches")
}

/// Ordered results for one search. Preserves Google's ranking.
model PlaceSearchHit {
  id        String      @id @default(cuid())
  searchId  String      @map("search_id")
  placeId   String      @map("place_id")
  rank      Int         @default(0)

  search    PlaceSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  place     Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([searchId, placeId])
  @@index([searchId, rank])
  @@map("place_search_hits")
}
