{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci",
  "buildCommand": "EXPO_PUBLIC_APP_ENV=production npm run build:web --workspace=@migo/mobile",
  "outputDirectory": "apps/mobile/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|icons/|favicon|manifest\\.webmanifest|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ]
}
